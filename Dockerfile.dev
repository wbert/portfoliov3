FROM node:22-alpine

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=development

RUN apk add --no-cache libc6-compat

COPY package*.json ./

# Install dependencies once; bind mounts plus a named volume keep modules persistent in dev.
RUN npm ci

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
